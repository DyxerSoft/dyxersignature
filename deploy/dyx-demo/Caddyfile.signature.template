# Sitio interno HTTP: Cloudflare Tunnel publica HTTPS y reenvia a Caddy 127.0.0.1:8080.
http://signature.dyxersoft.com {
    # El token demo (Development) solo se entrega tras autenticar con Caddy.
    handle /api/v1/auth/dev-token* {
        basic_auth {
            demo __SIGNATURE_PASSWORD_HASH__
        }
        reverse_proxy signature-frontend:80 {
            header_up -Authorization
        }
    }

    # URLs S3 prefirmadas: solo accesibles con firma y caducidad corta.
    # El Host debe conservarse para validar la firma SigV4.
    handle /dyxersignature/* {
        reverse_proxy signature-frontend:80 {
            header_up -Authorization
        }
    }

    # Las APIs de negocio usan JWT Bearer; no sustituir por HTTP Basic.
    handle /api/* {
        reverse_proxy signature-frontend:80
    }

    # El sitio y los recursos estáticos exigen credenciales de demostración.
    handle {
        basic_auth {
            demo __SIGNATURE_PASSWORD_HASH__
        }
        reverse_proxy signature-frontend:80 {
            header_up -Authorization
        }
    }
}
