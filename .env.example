# Local-only development values. Replace them outside the repository.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
AUTH_JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes-for-development
S3_ADMIN_ACCESS_KEY=signature-local-admin
S3_ADMIN_SECRET_KEY=replace-with-a-long-random-local-admin-secret
S3_ACCESS_KEY=signature-local-access
S3_SECRET_KEY=replace-with-a-long-random-local-s3-secret
S3_PUBLIC_URL=http://localhost:8333

# Required for real Stellar Testnet writes; keep the secret seed out of Git.
STELLAR_PUBLIC_KEY=
STELLAR_SECRET_SEED=
